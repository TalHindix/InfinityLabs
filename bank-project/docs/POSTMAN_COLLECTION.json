{
  "info": {
    "name": "Banking API - Dubai-Bank",
    "description": "REST API for Dubai-Bank application. Base URL: {{baseUrl}}. Auth: cookie 'token' or Authorization Bearer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:3000/health",
              "host": ["localhost"],
              "port": "3000",
              "path": ["health"]
            },
            "description": "Returns { status: 'ok', timestamp }. No auth."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"phone\": \"+1234567890\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/signup",
            "description": "Register user. Rate limited (authLimiter). 201: { success: true, data: { message: 'Please check your email to verify your account.' } }. 400: All fields are required. 409: This email is already registered."
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/verify?token=VERIFICATION_TOKEN_FROM_EMAIL",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify"],
              "query": [
                {
                  "key": "token",
                  "value": "VERIFICATION_TOKEN_FROM_EMAIL",
                  "description": "Token from verification email link"
                }
              ]
            },
            "description": "Verify email. Returns HTML page. Rate limited (verifyLimiter). 200 success, 400 if token missing or invalid."
          }
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/resend-verification",
            "description": "Resend verification email. Rate limited (authLimiter). 200: { success: true, data: { message: 'If this email exists and is not verified...' } }. 400: Email is required."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login",
            "description": "Login. Sets HTTP-only cookie 'token'. 200: { success: true, data: { user: { id, firstName, lastName, email } } }. 400: Email and password are required. 401: Invalid credentials."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/auth/logout",
            "description": "Clear auth cookie. 200: { success: true, data: null }. Send cookie or no; cookie is cleared on server."
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Get current user (me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/me",
            "description": "Requires auth (cookie or Authorization: Bearer <token>). 200: { success: true, data: { user: { id, firstName, lastName, email, phone, balance, status }, recentTransactions } }. 401: Authentication failed. 404: User not found."
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (default 1)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Page size (default 10, max 100)"
                }
              ]
            },
            "description": "Requires auth. 200: { success: true, data: { transactions, total, totalPages, currentPage } }."
          }
        },
        {
          "name": "Get transaction by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/1",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "1"]
            },
            "description": "Requires auth. Replace 1 with transaction id. 200: { success: true, data: { transaction } }. 404: Transaction not found."
          }
        },
        {
          "name": "Create transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverEmail\": \"other@example.com\",\n  \"amount\": 50.00,\n  \"description\": \"Payment for lunch\"\n}"
            },
            "url": "{{baseUrl}}/transactions",
            "description": "Requires auth. Rate limited (transactionLimiter). 201: { success: true, data: { transaction } }. 400: Receiver email is required, amount errors, Cannot transfer to yourself, Insufficient funds. 404: Receiver not found."
          }
        }
      ]
    }
  ]
}
